---
import { render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import BlogPostLayout from '../../layouts/BlogPostLayout.astro';
import { getPublishedPosts, type BlogPost } from '../../lib/blog';

export const getStaticPaths = (async () => {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: { post, newer: posts[index - 1], older: posts[index + 1] },
  }));
}) satisfies GetStaticPaths;

type Props = { post: BlogPost; newer?: BlogPost; older?: BlogPost };
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
---
<BlogPostLayout post={post} newer={newer} older={older}>
  <Content />
</BlogPostLayout>
