---
import ThemeToggle from '../components/ThemeToggle.astro';
import '../styles/global.css';

type Props = {
	title?: string;
	description?: string;
	type?: 'website' | 'article';
	image?: string;
	imageAlt?: string;
	publishedAt?: Date;
	updatedAt?: Date;
	tags?: string[];
};

const defaultTitle = 'Bernardo Santiago Marin | Portfolio';
const defaultDescription =
	'Portfolio of Bernardo Santiago Marin, a backend developer and computer science student building reliable backend systems, data tools, and full-stack products.';

const { title = defaultTitle, description = defaultDescription, type = 'website', image, imageAlt, publishedAt, updatedAt, tags = [] } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const socialImage = image ? new URL(image, Astro.site).href : undefined;
---

<!doctype html>
<html lang="en" data-theme="dark">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
		<link rel="manifest" href="/site.webmanifest">
		<meta name="description" content={description} />
		<meta name="theme-color" content="#050505" />
		<script is:inline>
			(() => {
				const storageKey = 'portfolio-theme';
				const themeColors = {
					dark: '#121212',
					light: '#f7f5ef',
				};

				const getPreferredTheme = () => {
					try {
						const savedTheme = window.localStorage.getItem(storageKey);

						if (savedTheme === 'light' || savedTheme === 'dark') {
							return savedTheme;
						}
					} catch {
						// localStorage can be unavailable in restricted browsing contexts.
					}

					return window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
				};

				const theme = getPreferredTheme();
				const themeColor = themeColors[theme];

				document.documentElement.dataset.theme = theme;
				document.documentElement.style.colorScheme = theme;

				const themeColorMeta = document.querySelector('meta[name="theme-color"]');

				if (themeColorMeta) {
					themeColorMeta.setAttribute('content', themeColor);
				}
			})();
		</script>
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<link rel="canonical" href={canonical.href} />
		<link rel="sitemap" href="/sitemap-index.xml" />
		<link rel="alternate" type="application/rss+xml" title="Bernardo Santiago Marin — Blog" href={new URL('/blog/rss.xml', Astro.site).href} />
		<meta property="og:type" content={type} />
		<meta property="og:url" content={canonical.href} />
		<meta property="og:site_name" content="Bernardo Santiago Marin" />
		<meta property="og:locale" content="en_US" />
		<meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		{socialImage && <>
			<meta property="og:image" content={socialImage} />
			<meta property="og:image:alt" content={imageAlt} />
			<meta name="twitter:image" content={socialImage} />
			<meta name="twitter:image:alt" content={imageAlt} />
		</>}
		{type === 'article' && <>
			<meta property="article:author" content="Bernardo Santiago Marin" />
			{publishedAt && <meta property="article:published_time" content={publishedAt.toISOString()} />}
			{updatedAt && <meta property="article:modified_time" content={updatedAt.toISOString()} />}
			{tags.map((tag) => <meta property="article:tag" content={tag} />)}
		</>}
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<div class="scroll-fade scroll-fade-top" aria-hidden="true"></div>
		<div class="scroll-fade scroll-fade-bottom" aria-hidden="true"></div>
		<slot />
		<ThemeToggle />
	</body>
</html>
