---
import Layout from './Layout.astro';
import BadgeList from '../components/portfolio/BadgeList.astro';
import { getProject, getProjectDetails } from '../data/portfolio';

type ProjectFrontmatter = {
	projectId: string;
};

type Props = {
	frontmatter: ProjectFrontmatter;
};

const { frontmatter } = Astro.props;
const project = getProject(frontmatter.projectId);
const projectDetails = getProjectDetails(frontmatter.projectId);
const pageTitle = `${project.name} | Bernardo Santiago Marin`;
const repositoryLabel = projectDetails.repository?.label ?? 'Repository';
---

<Layout title={pageTitle} description={project.description}>
	<main class="mx-auto w-full max-w-(--layout-max-width) px-5 sm:px-8 lg:px-10">
		<nav class="pt-8 sm:pt-10" aria-label="Project navigation">
			<a
				href="/#projects"
				class="inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.2em] text-(--color-muted) transition duration-150 hover:text-(--color-text)"
			>
				<span aria-hidden="true">&lt;-</span>
				Projects
			</a>
		</nav>

		<article class="project-detail pb-24 sm:pb-28">
			<header class="grid gap-10 border-b border-(--color-border) py-16 sm:py-20 lg:grid-cols-[minmax(0,1fr)_minmax(18rem,24rem)] lg:gap-16">
				<div class="max-w-3xl">
					<p class="mb-6 font-mono text-xs uppercase tracking-[0.24em] text-(--color-muted)">
						{project.period ?? 'Project'}
					</p>
					<h1 class="text-5xl font-extralight leading-none text-(--color-text) sm:text-6xl lg:text-7xl">
						{project.name}
					</h1>
					<p class="mt-7 max-w-2xl text-xl leading-9 text-(--color-muted) sm:text-2xl sm:leading-10">
						{project.description}
					</p>
				</div>

				<aside class="grid content-start gap-7 border-t border-(--color-border) pt-8 lg:border-t-0 lg:pt-0">
					{
						projectDetails.role && (
							<div class="space-y-2">
								<p class="font-mono text-xs uppercase tracking-[0.22em] text-(--color-muted)">
									Role
								</p>
								<p class="text-lg text-(--color-text)">{projectDetails.role}</p>
							</div>
						)
					}
					{
						project.technologies.length > 0 && (
							<div class="space-y-4">
								<p class="font-mono text-xs uppercase tracking-[0.22em] text-(--color-muted)">
									Stack
								</p>
								<BadgeList items={project.technologies} />
							</div>
						)
					}
					{
						projectDetails.repository && (
							<a
								href={projectDetails.repository.href}
								class="group inline-flex w-fit items-center gap-3 border-t border-(--color-border) pt-5 text-base text-(--color-text) transition duration-150 hover:border-(--color-border-strong)"
								target="_blank"
								rel="noreferrer"
							>
								{repositoryLabel}
								<span
									aria-hidden="true"
									class="text-(--color-muted) transition duration-150 group-hover:translate-x-1 group-hover:text-(--color-text)"
								>
									-&gt;
								</span>
							</a>
						)
					}
				</aside>
			</header>

			<div class="project-content">
				<slot />
			</div>
		</article>
	</main>
</Layout>
