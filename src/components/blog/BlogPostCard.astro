---
import BlogTags from './BlogTags.astro';
import { formatDate, postUrl, type BlogPost } from '../../lib/blog';
const { post } = Astro.props as { post: BlogPost };
---
<li class="blog-post-preview">
  <article>
    <time class="blog-date" datetime={post.data.publishedAt.toISOString()}>{formatDate(post.data.publishedAt)}</time>
    <h2><a href={postUrl(post)}>{post.data.title}<span aria-hidden="true"> ↗</span></a></h2>
    <p>{post.data.description}</p>
    <BlogTags tags={post.data.tags} />
  </article>
</li>
